{
  "name": "bikram-sambat-temporal",
  "version": "0.1.1",
  "description": "TypeScript library for Bikram Sambat (Nepali) calendar with Temporal.Calendar-like API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bikram-sambat",
    "nepali-calendar",
    "bs-calendar",
    "nepal",
    "calendar",
    "temporal"
  ],
  "author": "Dinesh Bhattarai",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "tsdown": "^0.19.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dineshdb/bikram-sambat-temporal.git"
  }
}
